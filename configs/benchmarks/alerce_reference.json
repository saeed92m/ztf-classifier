{
  "benchmark_id": "alerce_reference",
  "dataset_name": "ALeRCE API/TAP independent reference system",
  "source": "ALeRCE public API/TAP",
  "version": "live service; pin response manifest per run",
  "retrieval_date": "2026-09-25",
  "source_url": "https://alerce.online/",
  "doi": "NOT_APPLICABLE",
  "license": "ALeRCE service terms",
  "object_id_column": "oid",
  "label_column": "reference_label",
  "label_taxonomy": "reference-system output taxonomy; never ground truth",
  "class_mapping": {
    "source_native": "source_native"
  },
  "split_definition": {
    "strategy": "object manifest supplied by benchmark run"
  },
  "leakage_exclusions": [
    "ALeRCE outputs are never promoted to ground truth",
    "live responses are content-addressed per run"
  ],
  "preprocessing_contract": {
    "response_schema": "versioned",
    "query": "manifest-recorded"
  },
  "input_contract": {
    "adapter": "alerce_reference",
    "prediction_column": "y_pred",
    "query": "SELECT TOP 150\n    p.oid,\n    p.class_name,\n    p.probability,\n    p.classifier_name,\n    p.classifier_version\nFROM alerce_tap.probability AS p\nJOIN alerce_tap.object AS o\n  ON p.oid = o.oid\nWHERE o.sid = 1\n  AND p.probability IS NOT NULL\nORDER BY p.oid, p.class_name",
    "query_manifest": {
      "provider": "ALeRCE TAP",
      "endpoint": "https://tap.alerce.online/tap",
      "schema": "alerce_tap",
      "object_table": "alerce_tap.object",
      "probability_table": "alerce_tap.probability",
      "survey": "ZTF",
      "selection": "first 150 distinct ZTF object IDs with classifier probabilities, deterministic ORDER BY p.oid,p.class_name",
      "max_rows": 150,
      "expected_columns": [
        "oid",
        "class_name",
        "probability",
        "classifier_name",
        "classifier_version"
      ],
      "reference_only": true
    }
  },
  "ground_truth_provenance": {
    "kind": "external ground truth required separately",
    "is_model_agreement": false
  },
  "reference_system_provenance": {
    "kind": "independent classifier/reference prediction",
    "source": "ALeRCE API/TAP",
    "is_ground_truth": false
  },
  "benchmark_code_version": "benchmark-registry-v1",
  "required_leakage_checks": [
    "object_overlap",
    "duplicate_objects",
    "target_leakage",
    "future_data_leakage",
    "benchmark_trained_artifacts",
    "preprocessing_consistency",
    "schema_compatibility",
    "feature_generation_determinism",
    "qc_acceptance",
    "inference_reproducibility",
    "failure_code_correctness",
    "provenance"
  ],
  "evaluation_role": "reference_system"
}
