# ZTF Classifier API runtime configuration
ZTF_API_REGISTRY_DIR=/srv/ztf-classifier/models
ZTF_API_DEFAULT_MODEL_VERSION=baseline_v0.2
ZTF_API_OBSERVATION_CACHE_DIR=/srv/ztf-classifier/data/raw/alerce
ZTF_API_JOB_STORE=/srv/ztf-classifier/data/jobs/jobs.sqlite3
ZTF_API_RESULT_STORE=/srv/ztf-classifier/data/results/results.sqlite3
# Set in deployment secret management; do not commit a real credential.
ZTF_API_KEY=
